{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "age": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "isEmployed": {
      "type": "boolean"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    }
  },
  "required": ["age", "name", "isEmployed", "birthdate"],
  "additionalProperties": false
}
